# Copy to .env.local (git-ignored) to override.

# Leave empty to call /api on the same origin: the Vite dev proxy (below) in development,
# a reverse proxy in production. Set it only if the API is served from another origin;
# that origin must then be in the backend's CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=

# Where the Vite dev server forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:8080

# Where the Vite dev server forwards /api/notifications (notification-service).
VITE_NOTIFICATIONS_PROXY_TARGET=http://localhost:8082
