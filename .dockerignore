# Keeps the build context small and keeps secrets out of the image.
# (The Dockerfiles copy only what they build - this is the second safety net.)
# Used by both images built from this folder: the main app (Dockerfile) and notification-service
# (services/notification-service/Dockerfile).
.git
.github
.gradle
.idea
build
services/*/build
services/*/.gradle
services/*/.env
.env
.env.*
_to_delete
Claude outputs
screenshots
frontend
curl-commands.txt
*.md
Dockerfile
.dockerignore
docker-compose.yaml
